<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing worth backing up or transferring: the only stored value is the consent flag. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
